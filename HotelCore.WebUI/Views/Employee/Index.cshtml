@model IEnumerable<HotelCore.Application.DTOs.EmployeeDto>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Danh sách Nhân viên</h3>
    <a asp-action="Create" class="btn btn-orange"><i class="bi bi-person-plus-fill me-1"></i> Thêm Nhân viên</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Họ và Tên</th>
                        <th>Chức vụ</th>
                        <th>Liên hệ</th>
                        <th>Lương cơ bản</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.FullName</div>
                            </td>
                            <td><span class="badge bg-info text-dark">@item.RoleName</span></td>
                            <td>
                                <div><i class="bi bi-phone me-1"></i>@item.Phone</div>
                                <small class="text-muted">@item.Email</small>
                            </td>
                            <td class="fw-bold text-orange">@item.Salary.ToString("N0") đ</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Đang làm việc</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã nghỉ việc</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form id="deleteForm-@item.EmployeeId" asp-action="Delete" asp-route-id="@item.EmployeeId" method="post" class="d-inline">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('Xóa nhân viên?', 'Bạn có chắc muốn xóa nhân viên @item.FullName?', 'Đồng ý xóa', 'deleteForm-@item.EmployeeId')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
