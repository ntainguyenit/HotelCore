@model HotelCore.Application.DTOs.UserProfileDto
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-4 mb-4">
            <div class="mb-3">
                <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=d35400&color=fff&size=128" class="rounded-circle shadow-sm" alt="Avatar">
            </div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-orange fw-semibold mb-3">@Model.RoleName</p>
            <div class="d-grid">
                <button class="btn btn-outline-orange btn-sm">Thay đổi ảnh đại diện</button>
            </div>
            <hr class="my-4">
            <div class="text-start">
                <p class="mb-2"><i class="bi bi-envelope me-2 text-muted"></i> @Model.Email</p>
                <p class="mb-2"><i class="bi bi-telephone me-2 text-muted"></i> @Model.Phone</p>
                <p class="mb-0"><i class="bi bi-geo-alt me-2 text-muted"></i> @Model.Address</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2"></i>Thông tin chi tiết</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateProfile" method="post">
                    <input type="hidden" asp-for="EmployeeId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control bg-light" readonly />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DOB" class="form-label fw-semibold"></label>
                            <input asp-for="DOB" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-orange px-4">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold text-danger"><i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
                            <input name="currentPassword" type="password" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Mật khẩu mới</label>
                            <input name="newPassword" type="password" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Xác nhận mật khẩu</label>
                            <input type="password" class="form-control" required />
                        </div>
                    </div>
                    <div class="text-end mt-2">
                        <button type="submit" class="btn btn-danger px-4">Cập nhật mật khẩu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
