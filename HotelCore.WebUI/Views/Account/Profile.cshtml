@model HotelCore.Application.DTOs.UserProfileDto
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-4 mb-4">
            <div class="mb-3">
                <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=d35400&color=fff&size=128" class="rounded-circle shadow-sm" alt="Avatar">
            </div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-orange fw-semibold mb-3">@Model.RoleName</p>
            <div class="d-grid">
                <button class="btn btn-outline-orange btn-sm">Thay đổi ảnh đại diện</button>
            </div>
            <hr class="my-4">
            <div class="text-start">
                <p class="mb-2"><i class="bi bi-envelope me-2 text-muted"></i> @Model.Email</p>
                <p class="mb-2"><i class="bi bi-telephone me-2 text-muted"></i> @Model.Phone</p>
                <p class="mb-0"><i class="bi bi-geo-alt me-2 text-muted"></i> @Model.Address</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2 text-orange"></i>Thông tin chi tiết</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateProfile" method="post">
                    <input type="hidden" asp-for="EmployeeId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="FullName" class="form-control bg-light border-0 py-2" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="Username" class="form-control bg-light-soft border-0 py-2" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="Email" class="form-control bg-light border-0 py-2" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="Phone" class="form-control bg-light border-0 py-2" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="Address" class="form-control bg-light border-0 py-2" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DOB" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="DOB" class="form-control bg-light border-0 py-2" type="date" asp-format="{0:yyyy-MM-dd}" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <select asp-for="Gender" class="form-select bg-light border-0 py-2">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                    </div>
                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-orange px-5 py-2 fw-bold shadow-sm">
                            <i class="bi bi-save me-2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
