@model HotelCore.Application.DTOs.ChangePasswordDto
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm border-0 rounded-4 w-100" style="max-width: 800px;">
        <div class="row g-0">
            <div class="col-md-4 bg-orange text-white d-flex flex-column justify-content-center align-items-center p-4 rounded-start-4">
                <i class="bi bi-shield-lock-fill mb-3" style="font-size: 4rem;"></i>
                <h4 class="fw-bold mb-2">Bảo mật</h4>
                <p class="text-center small mb-0 opacity-75">Cập nhật mật khẩu định kỳ để bảo vệ tài khoản của bạn.</p>
            </div>
            <div class="col-md-8 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-dark mb-0">Đổi Mật Khẩu</h4>
                    <a asp-action="Profile" class="btn-close" aria-label="Close"></a>
                </div>
                
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold small"></label>
                            <input asp-for="CurrentPassword" class="form-control bg-light border-0" placeholder="Nhập mật khẩu hiện tại" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold small"></label>
                            <input asp-for="NewPassword" class="form-control bg-light border-0" placeholder="Mật khẩu mới" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small"></label>
                            <input asp-for="ConfirmPassword" class="form-control bg-light border-0" placeholder="Xác nhận lại" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-orange flex-grow-1 fw-bold shadow-sm py-2">
                            Xác nhận thay đổi
                        </button>
                        <a asp-action="Profile" class="btn btn-light px-4 fw-bold text-muted border-0">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
