@model IEnumerable<HotelCore.Application.DTOs.InvoiceDto>
@{
    ViewData["Title"] = "Lịch sử Hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Lịch sử Hóa đơn</h3>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã HĐ</th>
                        <th>Khách Hàng</th>
                        <th>Phòng</th>
                        <th>Ngày Xuất</th>
                        <th>Tổng Tiền</th>
                        <th>Thanh Toán</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#HĐ-@item.InvoiceId</td>
                            <td>@item.CustomerName</td>
                            <td><span class="badge bg-secondary">P.@item.RoomNumber</span></td>
                            <td>@item.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-orange">@item.TotalAmount.ToString("N0") đ</td>
                            <td>
                                <span class="badge @(item.PaymentMethod == "Cash" ? "bg-success" : "bg-primary")">
                                    @item.PaymentMethod
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-orange"><i class="bi bi-printer"></i> In</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
