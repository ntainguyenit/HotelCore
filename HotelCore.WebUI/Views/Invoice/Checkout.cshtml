@model HotelCore.Application.DTOs.CheckoutViewDto
@{
    ViewData["Title"] = "Thanh toán & Trả phòng";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark-orange text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Chi Tiết Thanh Toán - P.@Model.RoomNumber</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <h6 class="text-muted text-uppercase small fw-bold">Thông tin khách hàng</h6>
                        <p class="mb-0 fw-bold fs-5">@Model.CustomerName</p>
                        <p class="text-muted mb-0">Loại phòng: @Model.RoomType</p>
                    </div>
                    <div class="col-sm-6 text-sm-end">
                        <h6 class="text-muted text-uppercase small fw-bold">Thời gian lưu trú</h6>
                        <p class="mb-0">@Model.CheckInDate.ToString("dd/MM/yyyy HH:mm") - @Model.CheckOutDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="fw-bold text-orange">Tổng cộng: @Model.TotalDays Ngày</p>
                    </div>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered">
                        <thead class="bg-light">
                            <tr>
                                <th>Mô tả khoản thu</th>
                                <th class="text-center">Số lượng/Ngày</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Tiền phòng (@Model.RoomType)</td>
                                <td class="text-center">@Model.TotalDays</td>
                                <td class="text-end">@Model.RoomPricePerDay.ToString("N0") đ</td>
                                <td class="text-end fw-bold">@Model.RoomTotal.ToString("N0") đ</td>
                            </tr>
                            @foreach (var svc in Model.Services)
                            {
                                <tr>
                                    <td>Dịch vụ: @svc.ServiceName</td>
                                    <td class="text-center">@svc.Quantity</td>
                                    <td class="text-end">@svc.Price.ToString("N0") đ</td>
                                    <td class="text-end">@svc.SubTotal.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Tạm tính (Phòng + Dịch vụ):</th>
                                <th class="text-end">@((Model.RoomTotal + Model.ServiceTotal).ToString("N0")) đ</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end">Thuế GTGT (10%):</th>
                                <th class="text-end">@Model.TaxAmount.ToString("N0") đ</th>
                            </tr>
                            <tr class="table-warning">
                                <th colspan="3" class="text-end fs-5 text-dark">TỔNG CỘNG THANH TOÁN:</th>
                                <th class="text-end fs-5 text-orange">@Model.TotalAmount.ToString("N0") đ</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <form asp-action="Create" method="post">
                    <input type="hidden" name="BookingId" value="@Model.BookingId" />
                    <input type="hidden" name="RoomTotal" value="@Model.RoomTotal" />
                    <input type="hidden" name="ServiceTotal" value="@Model.ServiceTotal" />
                    <input type="hidden" name="TaxAmount" value="@Model.TaxAmount" />
                    <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />

                    <div class="d-flex flex-wrap justify-content-between align-items-center bg-light p-3 rounded-3">
                        <div class="mb-3 mb-md-0">
                            <label class="form-label fw-bold d-block mb-2">Phương thức thanh toán:</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="payCash" value="Cash" checked>
                                    <label class="form-check-label fw-semibold" for="payCash">Tiền mặt</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="payCard" value="Credit Card">
                                    <label class="form-check-label fw-semibold" for="payCard">Thẻ tín dụng</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="payBank" value="Bank Transfer">
                                    <label class="form-check-label fw-semibold" for="payBank">Chuyển khoản</label>
                                </div>
                            </div>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold">Quay Lại</a>
                            <button type="submit" class="btn btn-orange px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-check2-square me-2"></i> XÁC NHẬN THANH TOÁN
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
