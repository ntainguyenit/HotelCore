@model IEnumerable<HotelCore.Application.DTOs.CustomerDto>
@{
    ViewData["Title"] = "Danh sách Khách Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Quản lý Khách Hàng</h3>
    <a asp-action="Create" class="btn btn-orange"><i class="bi bi-person-plus me-1"></i> Thêm Khách Hàng</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Họ và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>CMND/CCCD</th>
                        <th>Email</th>
                        <th>Địa Chỉ</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.FullName</div>
                                <small class="text-muted">@item.Gender | @(item.DOB?.ToString("dd/MM/yyyy") ?? "N/A")</small>
                            </td>
                            <td>@item.Phone</td>
                            <td>@item.IdCardNumber</td>
                            <td>@item.Email</td>
                            <td class="text-truncate" style="max-width: 200px;">@item.Address</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
