@model HotelCore.Application.DTOs.SystemSettingsDto
@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark"><i class="bi bi-gear-fill me-2 text-orange"></i>Cài đặt hệ thống</h3>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="row g-0">
            <div class="col-md-3 border-end bg-light p-4">
                <div class="nav flex-column nav-pills" id="settings-tabs" role="tablist">
                    <button class="nav-link active text-start mb-2" data-bs-toggle="pill" data-bs-target="#tab-general" type="button">
                        <i class="bi bi-info-circle me-2"></i> Thông tin chung
                    </button>
                    <button class="nav-link text-start mb-2" data-bs-toggle="pill" data-bs-target="#tab-financial" type="button">
                        <i class="bi bi-cash-stack me-2"></i> Tài chính & Thuế
                    </button>
                    <button class="nav-link text-start mb-2" data-bs-toggle="pill" data-bs-target="#tab-branding" type="button">
                        <i class="bi bi-palette me-2"></i> Thương hiệu & Logo
                    </button>
                </div>
            </div>
            <div class="col-md-9 p-4">
                <form asp-action="Update" method="post" enctype="multipart/form-data">
                    <div class="tab-content" id="settings-tabContent">
                        <!-- Tab: General -->
                        <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                            <h5 class="fw-bold mb-4">Thông tin khách sạn</h5>
                            <div class="mb-3">
                                <label asp-for="HotelName" class="form-label fw-semibold"></label>
                                <input asp-for="HotelName" class="form-control" />
                                <span asp-validation-for="HotelName" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="HotelAddress" class="form-label fw-semibold"></label>
                                <input asp-for="HotelAddress" class="form-control" />
                                <span asp-validation-for="HotelAddress" class="text-danger small"></span>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="HotelPhone" class="form-label fw-semibold"></label>
                                    <input asp-for="HotelPhone" class="form-control" />
                                    <span asp-validation-for="HotelPhone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="HotelEmail" class="form-label fw-semibold"></label>
                                    <input asp-for="HotelEmail" class="form-control" />
                                    <span asp-validation-for="HotelEmail" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Tab: Financial -->
                        <div class="tab-pane fade" id="tab-financial" role="tabpanel">
                            <h5 class="fw-bold mb-4">Cấu hình Tài chính</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="VatRate" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="VatRate" class="form-control" type="number" step="0.1" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="VatRate" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ServiceFee" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="ServiceFee" class="form-control" type="number" step="0.1" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="ServiceFee" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Currency" class="form-label fw-semibold"></label>
                                <select asp-for="Currency" class="form-select">
                                    <option value="VND">Việt Nam Đồng (VND)</option>
                                    <option value="USD">Đô la Mỹ (USD)</option>
                                    <option value="EUR">Euro (EUR)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Tab: Branding -->
                        <div class="tab-pane fade" id="tab-branding" role="tabpanel">
                            <h5 class="fw-bold mb-4">Thương hiệu & Logo</h5>
                            <div class="mb-4">
                                <label class="form-label fw-semibold d-block">Logo hiện tại</label>
                                <div class="p-3 border rounded-3 d-inline-block bg-light mb-2">
                                    <img src="@Model.LogoPath" id="logo-preview" style="max-height: 80px;" alt="Hotel Logo" onerror="this.src='https://placehold.co/200x80?text=No+Logo'">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                                <input asp-for="LogoFile" class="form-control" type="file" accept="image/*" onchange="previewImage(this)">
                                <small class="text-muted">Kích thước khuyên dùng: 200x80px (PNG minh họa)</small>
                                <input type="hidden" asp-for="LogoPath" />
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">
                    <div class="text-end">
                        <button type="submit" class="btn btn-orange px-5 py-2 fw-bold">LƯU CÀI ĐẶT</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#logo-preview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
