@model HotelCore.Application.DTOs.PagedResultDto<HotelCore.Application.DTOs.ServiceDto>
@{
    ViewData["Title"] = "Quản lý Dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Danh mục Dịch vụ</h3>
    <a asp-action="Create" class="btn btn-orange"><i class="bi bi-plus-circle me-1"></i> Thêm dịch vụ mới</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" placeholder="Tìm tên dịch vụ..." value="@ViewBag.SearchTerm">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-light border w-100">Tìm kiếm</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên dịch vụ</th>
                        <th>Đơn vị tính</th>
                        <th>Đơn giá</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy dịch vụ nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.ServiceName</td>
                            <td>@item.Unit</td>
                            <td class="fw-bold text-orange">@item.Price.ToString("N0") đ</td>
                            <td>
                                <span class="badge @(item.Status ? "badge-soft-success" : "badge-soft-danger") px-3 py-2">
                                    <i class="bi @(item.Status ? "bi-check-circle-fill" : "bi-dash-circle-fill") me-1"></i>
                                    @item.StatusText
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.ServiceId" class="btn btn-sm btn-outline-primary me-2"><i class="bi bi-pencil"></i></a>
                                <form id="deleteForm-@item.ServiceId" asp-action="Delete" asp-route-id="@item.ServiceId" method="post" class="d-inline">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('Xóa dịch vụ?', 'Bạn có chắc muốn xóa dịch vụ @item.ServiceName?', 'Đồng ý xóa', 'deleteForm-@item.ServiceId')"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang -->
<div class="d-flex flex-column align-items-center mb-5 mt-4">
    <nav aria-label="Page navigation" class="mb-3">
        <ul class="pagination pagination-md mb-0">
            <!-- Nút Trước -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link shadow-sm border-0 rounded-pill me-2 px-3 d-flex align-items-center" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchTerm="@ViewBag.SearchTerm">
                    <i class="bi bi-chevron-left me-1"></i> Trước
                </a>
            </li>
            
            @{
                int startPage = Math.Max(1, Model.PageNumber - 1);
                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 1);

                // Luôn hiển thị trang 1
                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link shadow-sm border-0 rounded-circle me-2 d-flex align-items-center justify-content-center bg-white text-dark" style="width: 38px; height: 38px;" asp-action="Index" asp-route-pageNumber="1" asp-route-searchTerm="@ViewBag.SearchTerm">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link shadow-sm border-0 rounded-circle me-2 d-flex align-items-center justify-content-center @(i == Model.PageNumber ? "bg-orange text-white" : "bg-white text-dark")" style="width: 38px; height: 38px;" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                    </li>
                }

                // Luôn hiển thị trang cuối
                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link shadow-sm border-0 rounded-circle me-2 d-flex align-items-center justify-content-center bg-white text-dark" style="width: 38px; height: 38px;" asp-action="Index" asp-route-pageNumber="@Model.TotalPages" asp-route-searchTerm="@ViewBag.SearchTerm">@Model.TotalPages</a>
                    </li>
                }
            }

            <!-- Nút Sau -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link shadow-sm border-0 rounded-pill px-3 d-flex align-items-center" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchTerm="@ViewBag.SearchTerm">
                    Sau <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </li>
        </ul>
    </nav>
    <div class="text-muted small fw-medium">
        Đang hiển thị <span class="text-dark fw-bold">@Model.Items.Count()</span> trên tổng số <span class="text-dark fw-bold">@Model.TotalCount</span> dịch vụ
    </div>
</div>

<style>
    .bg-orange { background-color: var(--dark-orange) !important; color: white !important; }
    .border-orange { border-color: var(--dark-orange) !important; }
    .page-link { color: var(--dark-orange); }
    .page-item.active .page-link { border-color: var(--dark-orange); }
</style>
