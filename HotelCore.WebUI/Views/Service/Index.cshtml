@model IEnumerable<HotelCore.Application.DTOs.ServiceDto>
@{
    ViewData["Title"] = "Quản lý Dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Danh mục Dịch vụ</h3>
    <a asp-action="Create" class="btn btn-orange"><i class="bi bi-plus-circle me-1"></i> Thêm dịch vụ mới</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" placeholder="Tìm tên dịch vụ..." value="@ViewBag.SearchTerm">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-light border w-100">Tìm kiếm</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên dịch vụ</th>
                        <th>Đơn vị tính</th>
                        <th>Đơn giá</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy dịch vụ nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.ServiceName</td>
                            <td>@item.Unit</td>
                            <td class="fw-bold text-orange">@item.Price.ToString("N0") đ</td>
                            <td>
                                <span class="badge @(item.Status ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-2">
                                    <i class="bi @(item.Status ? "bi-check-circle-fill" : "bi-dash-circle-fill") me-1"></i>
                                    @item.StatusText
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.ServiceId" class="btn btn-sm btn-outline-primary me-2"><i class="bi bi-pencil"></i></a>
                                <form id="deleteForm-@item.ServiceId" asp-action="Delete" asp-route-id="@item.ServiceId" method="post" class="d-inline">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('Xóa dịch vụ?', 'Bạn có chắc muốn xóa dịch vụ @item.ServiceName?', 'Đồng ý xóa', 'deleteForm-@item.ServiceId')"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
