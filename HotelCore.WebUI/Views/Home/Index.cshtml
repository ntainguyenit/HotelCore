@model HotelCore.Application.DTOs.DashboardOverviewDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Tổng quan Khách Sạn</h3>
    <div class="d-flex">
        <a href="/Booking/Create" class="btn btn-orange me-2 shadow-sm"><i class="bi bi-plus-circle me-1"></i> Đặt phòng mới</a>
        <div class="dropdown">
            <button class="btn btn-outline-orange dropdown-toggle shadow-sm" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-download me-1"></i> Xuất báo cáo
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="exportDropdown">
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportToExcel()"><i class="bi bi-file-earmark-excel text-success me-2"></i> Xuất file Excel (.csv)</a></li>
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportToPDF()"><i class="bi bi-file-earmark-pdf text-danger me-2"></i> Xuất file PDF (In sơ đồ)</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Thống kê nhanh (Dynamic) -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-light-orange p-3 rounded-3 me-3 text-orange">
                    <i class="bi bi-door-open fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Phòng Trống</h6>
                    <h3 class="fw-bold mb-0">@Model.AvailableRooms <span class="fs-6 text-muted fw-normal">/ @Model.TotalRooms</span></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 p-3 rounded-3 me-3 text-danger">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Đang Có Khách</h6>
                    <h3 class="fw-bold mb-0">@Model.OccupiedRooms</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3 text-success">
                    <i class="bi bi-check-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Check-in Hôm Nay</h6>
                    <h3 class="fw-bold mb-0">@Model.CheckInToday</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3 text-warning">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Doanh Thu Ngày</h6>
                    <h3 class="fw-bold mb-0">@Model.TodayRevenue.ToString("N0") đ</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lưới Phòng Trực Quan (Dynamic) -->
<!-- Bộ lọc Tầng -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">Sơ đồ phòng hiện tại</h5>
    <div class="btn-group" role="group" aria-label="Floor filter">
        <button type="button" class="btn btn-sm btn-outline-orange active shadow-sm px-3" onclick="filterFloor('all', this)">Tất cả</button>
        <button type="button" class="btn btn-sm btn-outline-orange shadow-sm px-3" onclick="filterFloor('1', this)">Tầng 1</button>
        <button type="button" class="btn btn-sm btn-outline-orange shadow-sm px-3" onclick="filterFloor('2', this)">Tầng 2</button>
        <button type="button" class="btn btn-sm btn-outline-orange shadow-sm px-3" onclick="filterFloor('3', this)">Tầng 3</button>
        <button type="button" class="btn btn-sm btn-outline-orange shadow-sm px-3" onclick="filterFloor('4', this)">Tầng 4</button>
    </div>
</div>

<div class="row g-3" id="room-grid-container">
    @if (Model.RoomGrids != null && Model.RoomGrids.Any())
    {
        var groupedRooms = Model.RoomGrids.GroupBy(r => r.Floor).OrderBy(g => g.Key);

        foreach (var floorGroup in groupedRooms)
        {
            <div class="col-12 mt-4 mb-2 floor-section" data-floor="@floorGroup.Key">
                <div class="d-flex align-items-center">
                    <span class="badge bg-dark-orange px-3 py-2 me-3">TẦNG @floorGroup.Key</span>
                    <hr class="flex-grow-1 opacity-25">
                </div>
            </div>

            foreach (var room in floorGroup)
            {
                var borderClass = room.Status switch
                {
                    "Available" => "room-available",
                    "Occupied" => "room-occupied",
                    "Cleaning" => "room-cleaning",
                    _ => "room-available"
                };

                var badgeClass = room.Status switch
                {
                    "Available" => "badge-soft-success",
                    "Occupied" => "badge-soft-danger",
                    "Cleaning" => "badge-soft-warning",
                    _ => "badge-soft-secondary"
                };

                var statusText = room.Status switch
                {
                    "Available" => "Trống",
                    "Occupied" => "Đang thuê",
                    "Cleaning" => "Dọn dẹp",
                    "Maintenance" => "Bảo trì",
                    _ => room.Status
                };

                <div class="col-md-2 col-sm-4 col-6 room-item" data-floor="@floorGroup.Key">
                    @if (room.Status == "Occupied")
                    {
                        <a href="/Invoice/Checkout?bookingId=1" class="text-decoration-none text-dark">
                            <div class="card room-card @borderClass h-100 p-3 text-center shadow-sm">
                                <h5 class="fw-bold mb-1 @(room.TypeName != null && (room.TypeName.Contains("VIP") || room.TypeName.Contains("Suite")) ? "text-orange" : "")">
                                    @room.RoomNumber
                                </h5>
                                <span class="badge @badgeClass mb-2">@statusText</span>
                                <small class="text-muted d-block text-truncate">@(string.IsNullOrEmpty(room.CurrentCustomerName) ? "Khách ẩn danh" : room.CurrentCustomerName)</small>
                                <small class="text-orange d-block mt-1 fw-bold" style="font-size: 0.7rem;"><i class="bi bi-box-arrow-right me-1"></i>THANH TOÁN</small>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="card room-card @borderClass h-100 p-3 text-center shadow-sm">
                            <h5 class="fw-bold mb-1 @(room.TypeName != null && (room.TypeName.Contains("VIP") || room.TypeName.Contains("Suite")) ? "text-orange" : "")">
                                @room.RoomNumber
                            </h5>
                            <span class="badge @badgeClass mb-2">@statusText</span>
                            
                            @if (room.Status == "Available")
                            {
                                <small class="text-muted d-block"><i class="bi bi-person"></i> @room.Capacity người</small>
                            }
                            else if (room.Status == "Cleaning")
                            {
                                <small class="text-muted d-block"><i class="bi bi-clock"></i> Đang dọn</small>
                            }
                            else
                            {
                                <small class="text-muted d-block"><i class="bi bi-tools"></i> Bảo trì</small>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">Chưa có dữ liệu phòng.</div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterFloor(floor, btn) {
            // Cập nhật trạng thái active của nút
            const buttons = document.querySelectorAll('.btn-group .btn');
            buttons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const sections = document.querySelectorAll('.floor-section');
            const rooms = document.querySelectorAll('.room-item');

            if (floor === 'all') {
                sections.forEach(s => s.classList.remove('d-none'));
                rooms.forEach(r => r.classList.remove('d-none'));
            } else {
                sections.forEach(s => {
                    if (s.getAttribute('data-floor') === floor) {
                        s.classList.remove('d-none');
                    } else {
                        s.classList.add('d-none');
                    }
                });

                rooms.forEach(r => {
                    if (r.getAttribute('data-floor') === floor) {
                        r.classList.remove('d-none');
                    } else {
                        r.classList.add('d-none');
                    }
                });
            }
        }

        function exportToExcel() {
            let csv = "\uFEFF"; // Byte Order Mark for Excel Vietnamese support
            csv += "Tầng,Số Phòng,Trạng Thái,Khách Hàng\n";
            
            const rooms = document.querySelectorAll('.room-item');
            rooms.forEach(room => {
                const floor = room.getAttribute('data-floor');
                const number = room.querySelector('h5').innerText.trim();
                const status = room.querySelector('.badge').innerText.trim();
                const customer = room.querySelector('small')?.innerText.trim() || "";
                csv += `${floor},${number},${status},${customer}\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", "Bao_cao_so_do_phong.csv");
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            toastr.success("Đã xuất file Excel thành công!");
        }

        function exportToPDF() {
            window.print();
        }
    </script>
}

<style>
    @@media print {
        #sidebar, .navbar, .btn-group, .dropdown, .btn-orange, .badge-soft-secondary {
            display: none !important;
        }
        .content-wrapper {
            margin-left: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }
        #content {
            width: 100% !important;
            padding: 0 !important;
        }
        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
            break-inside: avoid;
        }
        .floor-section {
            break-before: auto;
            margin-top: 20px !important;
        }
        body {
            background: white !important;
        }
    }
</style>


