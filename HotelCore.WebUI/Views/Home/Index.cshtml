@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Tổng quan Khách Sạn</h3>
    <div>
        <button class="btn btn-orange me-2"><i class="bi bi-plus-circle me-1"></i> Đặt phòng mới</button>
        <button class="btn btn-outline-orange"><i class="bi bi-download me-1"></i> Xuất báo cáo</button>
    </div>
</div>

<!-- Thống kê nhanh -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-light-orange p-3 rounded-3 me-3 text-orange">
                    <i class="bi bi-door-open fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Phòng Trống</h6>
                    <h3 class="fw-bold mb-0">15 <span class="fs-6 text-muted fw-normal">/ 40</span></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 p-3 rounded-3 me-3 text-danger">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Đang Có Khách</h6>
                    <h3 class="fw-bold mb-0">22</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3 text-success">
                    <i class="bi bi-check-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Check-in Hôm Nay</h6>
                    <h3 class="fw-bold mb-0">8</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3 text-warning">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Doanh Thu Ngày</h6>
                    <h3 class="fw-bold mb-0">12.5M</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lưới Phòng Trực Quan -->
<h5 class="fw-bold mb-3">Sơ đồ phòng hiện tại</h5>
<div class="row g-3">
    <!-- Tầng 1 -->
    <div class="col-12 mb-2"><span class="badge bg-secondary">Tầng 1 (Standard)</span></div>
    
    <div class="col-md-2 col-sm-4 col-6">
        <div class="card room-card room-available h-100 p-3 text-center">
            <h5 class="fw-bold mb-1">101</h5>
            <span class="badge badge-soft-success mb-2">Trống</span>
            <small class="text-muted d-block"><i class="bi bi-person"></i> 2 người</small>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6">
        <div class="card room-card room-occupied h-100 p-3 text-center">
            <h5 class="fw-bold mb-1">102</h5>
            <span class="badge badge-soft-danger mb-2">Đang thuê</span>
            <small class="text-muted d-block text-truncate">Lê Hoàng C</small>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6">
        <div class="card room-card room-available h-100 p-3 text-center">
            <h5 class="fw-bold mb-1">103</h5>
            <span class="badge badge-soft-success mb-2">Trống</span>
            <small class="text-muted d-block"><i class="bi bi-person"></i> 2 người</small>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6">
        <div class="card room-card room-cleaning h-100 p-3 text-center">
            <h5 class="fw-bold mb-1">104</h5>
            <span class="badge badge-soft-warning mb-2">Dọn dẹp</span>
            <small class="text-muted d-block"><i class="bi bi-clock"></i> 30 min</small>
        </div>
    </div>

    <!-- Tầng 2 -->
    <div class="col-12 mt-4 mb-2"><span class="badge bg-secondary">Tầng 2 (VIP/Suite)</span></div>
    
    <div class="col-md-2 col-sm-4 col-6">
        <div class="card room-card room-occupied h-100 p-3 text-center">
            <h5 class="fw-bold mb-1 text-orange">201 VIP</h5>
            <span class="badge badge-soft-danger mb-2">Đang thuê</span>
            <small class="text-muted d-block text-truncate">Phạm Thị D</small>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6">
        <div class="card room-card room-available h-100 p-3 text-center">
            <h5 class="fw-bold mb-1 text-orange">202 VIP</h5>
            <span class="badge badge-soft-success mb-2">Trống</span>
            <small class="text-muted d-block"><i class="bi bi-person"></i> 4 người</small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>
}
