<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelCore.WebUI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar bg-dark-orange text-white">
            <div class="sidebar-header d-flex align-items-center justify-content-center">
                <a href="/" class="text-white text-decoration-none d-flex align-items-center">
                    <i class="bi bi-buildings fs-2 me-2"></i>
                    <h4 class="mb-0 fw-bold">HotelCore</h4>
                </a>
            </div>

            <ul class="list-unstyled components p-3">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                }
                <p class="text-uppercase text-white-50 fw-bold fs-7 mb-2">Quản lý</p>
                <li class="nav-item mb-1">
                    <a href="/" class="nav-link text-white rounded @(controller == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Booking/Create" class="nav-link text-white rounded @(controller == "Booking" ? "active" : "")">
                        <i class="bi bi-door-open me-2"></i> Đặt Phòng
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Invoice/Index" class="nav-link text-white rounded @(controller == "Invoice" ? "active" : "")">
                        <i class="bi bi-journal-text me-2"></i> Hóa Đơn
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Service/Index" class="nav-link text-white rounded @(controller == "Service" ? "active" : "")">
                        <i class="bi bi-cup-hot me-2"></i> Dịch Vụ
                    </a>
                <li class="nav-item mb-1">
                    <a href="/Report/Index" class="nav-link text-white rounded @(controller == "Report" ? "active" : "")">
                        <i class="bi bi-graph-up-arrow me-2"></i> Báo Cáo
                    </a>
                </li>
                
                <p class="text-uppercase text-white-50 fw-bold fs-7 mb-2 mt-4">Danh mục</p>
                <li class="nav-item mb-1">
                    <a href="/Customer/Index" class="nav-link text-white rounded @(controller == "Customer" ? "active" : "")">
                        <i class="bi bi-people me-2"></i> Khách Hàng
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Employee/Index" class="nav-link text-white rounded @(controller == "Employee" ? "active" : "")">
                        <i class="bi bi-person-badge me-2"></i> Nhân Viên
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Setting/Index" class="nav-link text-white rounded @(controller == "Setting" ? "active" : "")">
                        <i class="bi bi-gear me-2"></i> Cài Đặt
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content" class="content-wrapper w-100 bg-light">
            <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top">
                <div class="container-fluid px-4">
                    <button type="button" id="sidebarCollapse" class="btn btn-outline-orange">
                        <i class="bi bi-list"></i>
                    </button>
                    
                    <div class="d-flex align-items-center ms-auto">
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle py-1" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="avatar-circle me-2">
                                    @(User.Identity.Name?.Substring(0, 1) ?? "U")
                                </div>
                                <div class="d-none d-sm-block text-start">
                                    <span class="fw-bold text-dark me-1">@User.Identity.Name</span>
                                    <small class="text-muted">(@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "N/A"))</small>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 mt-2" aria-labelledby="profileDropdown" style="min-width: 200px;">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2 text-primary"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-warning"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4 pb-4 flex-grow-1">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
            
            <div class="main-footer py-3 bg-dark text-white text-center fs-7">
                <div class="container-fluid px-4">
                    &copy; 2026 - HotelCore Management System
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Cấu hình Toastr
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        // Hiển thị thông báo từ TempData
        $(document).ready(function() {
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';
            var info = '@TempData["Info"]';

            if (success) toastr.success(success);
            if (error) toastr.error(error);
            if (info) toastr.info(info);

            // Toggle Sidebar
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });

        // Hàm xác nhận xóa dùng SweetAlert2
        function confirmDelete(title, text, confirmButtonText, formId) {
            Swal.fire({
                title: title || 'Bạn có chắc chắn?',
                text: text || "Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d35400',
                cancelButtonColor: '#6c757d',
                confirmButtonText: confirmButtonText || 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
            return false;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
