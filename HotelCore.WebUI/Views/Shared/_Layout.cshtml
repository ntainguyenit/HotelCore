<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HotelCore.WebUI.styles.css" asp-append-version="true" />
    <!-- Thêm icon Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar bg-dark-orange text-white">
            <div class="sidebar-header d-flex align-items-center justify-content-center py-4 border-bottom border-light border-opacity-25">
                <i class="bi bi-buildings fs-2 me-2"></i>
                <h4 class="mb-0 fw-bold">HotelCore</h4>
            </div>

            <ul class="list-unstyled components p-3">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                }
                <p class="text-uppercase text-white-50 fw-bold fs-7 mb-2">Quản lý</p>
                <li class="nav-item mb-1">
                    <a href="/" class="nav-link text-white rounded @(controller == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Booking/Create" class="nav-link text-white rounded @(controller == "Booking" ? "active" : "")">
                        <i class="bi bi-door-open me-2"></i> Đặt Phòng
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Invoice/Index" class="nav-link text-white rounded @(controller == "Invoice" ? "active" : "")">
                        <i class="bi bi-journal-text me-2"></i> Hóa Đơn
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Service/Index" class="nav-link text-white rounded @(controller == "Service" ? "active" : "")">
                        <i class="bi bi-cup-hot me-2"></i> Dịch Vụ
                    </a>
                </li>
                
                <p class="text-uppercase text-white-50 fw-bold fs-7 mb-2 mt-4">Danh mục</p>
                <li class="nav-item mb-1">
                    <a href="/Customer/Index" class="nav-link text-white rounded @(controller == "Customer" ? "active" : "")">
                        <i class="bi bi-people me-2"></i> Khách Hàng
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/Employee/Index" class="nav-link text-white rounded @(controller == "Employee" ? "active" : "")">
                        <i class="bi bi-person-badge me-2"></i> Nhân Viên
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a href="#" class="nav-link text-white rounded">
                        <i class="bi bi-gear me-2"></i> Cài Đặt
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content" class="content-wrapper w-100 bg-light">
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4 py-3">
                <div class="container-fluid px-4">
                    <button type="button" id="sidebarCollapse" class="btn btn-outline-orange">
                        <i class="bi bi-list"></i>
                    </button>
                    
                    <div class="d-flex align-items-center ms-auto">
                        <div class="position-relative me-3">
                            <i class="bi bi-bell fs-5 text-secondary"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                3
                            </span>
                        </div>
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=d35400&color=fff" class="rounded-circle me-2" width="32" height="32" alt="User">
                                <div class="d-none d-md-block text-start">
                                    <div class="fw-semibold lh-1" style="font-size: 0.9rem;">@User.Identity.Name</div>
                                    <small class="text-muted" style="font-size: 0.75rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4 pb-4 flex-grow-1">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
            
            <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted fs-7">
                <div class="container-fluid px-4">
                    &copy; 2026 - HotelCore Management System - Developed by You
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
